PROGRAM Simple_Shopping_Calculator

DECLARE
  var nama, lagi : string 
  var jumlah, n, i : integer 
  var persenDiskon : integer
  var harga, subtotal : real
  var total, diskon, totalAkhir : real
  var bayar, kembali : real

LOGARITHM
START
  ASSIGN lagi = "y"
  ASSIGN n = 0
  OUTPUT "=====DAFTAR BELANJA====="

  WHILE lagi = "y"
    OUTPUT "Nama barang:"
    INPUT nama
    OUTPUT "Harga barang:"
    INPUT harga
    OUTPUT "Jumlah barang:"
    INPUT jumlah

    ASSIGN subtotal = harga * jumlah 
    ASSIGN n = n + 1
    OUTPUT nama + " " + harga + " x " + jumlah + "=" + subtotal
    OUTPUT "Tambah barang lagi? (y/n):"
    INPUT lagi 
  ENDWHILE

  ASSIGN total = 0
  FOR i = 0 to n-1
    ASSIGN total = total + subtotal
  ENDFOR 

  IF total >= 100000 
    ASSIGN persenDiskon = 10 
  ELSE 
    IF total >= 50000 
      ASSIGN persenDiskon = 5
    ELSE 
      ASSIGN persenDiskon = 0
  ENDIF

  ASSIGN diskon = total * persenDiskon / 100
  ASSIGN totalAkhir = total - diskon

  OUTPUT "========== Ringkasan Transaksi =========="
  OUTPUT "Total sebelum diskon : " + total
  OUTPUT "Diskon (" + persenDiskon + "%) : " + diskon
  OUTPUT "Total akhir : " + totalAkhir
  OUTPUT "Jumlah uang dibayar: "
  INPUT bayar 

  WHILE bayar < totalAkhir 
    OUTPUT "Uang pembayaran kurang! Silahkan coba lagi."
    OUTPUT "Jumlah uang dibayar : "
    INPUT bayar
  ENDWHILE

  ASSIGN kembali = bayar - totalAkhir
  OUTPUT "Uang dibayar  : " + bayar
  OUTPUT "Uang kembali  : " + kembali
  OUTPUT "Terima kasih telah berbelanja!"

STOP
  


