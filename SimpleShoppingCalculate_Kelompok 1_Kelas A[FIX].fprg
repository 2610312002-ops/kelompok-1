<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flowchart kel.2"/>
        <attribute name="authors" value="HYPE 7 AMD X8-1"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 01:09:56 AM"/>
        <attribute name="created" value="SFlQRSA3IEFNRCBYOC0xO0hZUEU3QU1EWDgtMTsyMDI2LTA5LTE0OzAzOjE3OjI4IFBNOzMwMTE="/>
        <attribute name="edited" value="SFlQRSA3IEFNRCBYOC0xO0hZUEU3QU1EWDgtMTsyMDI2LTA5LTE2OzAxOjA5OjU2IEFNOzY7MzExMQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nama" type="String" array="False" size=""/>
            <declare name="harga" type="Real" array="False" size=""/>
            <declare name="jumlah" type="Integer" array="False" size=""/>
            <declare name="subtotal" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="persenDiskon" type="Integer" array="False" size=""/>
            <declare name="diskon" type="Real" array="False" size=""/>
            <declare name="totalAkhir" type="Real" array="False" size=""/>
            <declare name="bayar" type="Real" array="False" size=""/>
            <declare name="kembali" type="Real" array="False" size=""/>
            <declare name="lagi" type="String" array="False" size=""/>
            <assign variable="lagi" expression="&quot;y&quot;"/>
            <assign variable="total" expression="0"/>
            <output expression="&quot;=====DAFTAR BELANJA=====&quot;" newline="True"/>
            <while expression="lagi = &quot;y&quot;">
                <output expression="&quot;Nama barang: &quot;" newline="True"/>
                <input variable="nama"/>
                <output expression="&quot;Harga barang: &quot;" newline="True"/>
                <input variable="harga"/>
                <output expression="&quot;Jumlah barang: &quot;" newline="True"/>
                <input variable="jumlah"/>
                <assign variable="subtotal" expression="harga * jumlah"/>
                <assign variable="total" expression="total + subtotal"/>
                <output expression="nama &amp; &quot; &quot; &amp; harga &amp; &quot; x &quot; &amp; jumlah &amp; &quot; = &quot; &amp; subtotal" newline="True"/>
                <output expression="&quot;Tambah barang lagi? (y/n): &quot;" newline="True"/>
                <input variable="lagi"/>
            </while>
            <if expression="total &gt;= 100000">
                <then>
                    <assign variable="persenDiskon" expression="10"/>
                </then>
                <else>
                    <if expression="total &gt;= 50000">
                        <then>
                            <assign variable="persenDiskon" expression="5"/>
                        </then>
                        <else>
                            <assign variable="persenDiskon" expression="0"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="diskon" expression="total * persenDiskon / 100"/>
            <assign variable="totalAkhir" expression="total - diskon"/>
            <output expression="&quot;=====Ringkasan Transaksi=====&quot;" newline="True"/>
            <output expression="&quot;Total sebelum diskon : &quot; &amp; total" newline="True"/>
            <output expression="&quot;Diskon (&quot; &amp; persenDiskon &amp; &quot;%) : &quot; &amp; diskon" newline="True"/>
            <output expression="&quot;Total Akhir : &quot; &amp; totalAkhir" newline="True"/>
            <output expression="&quot;Jumlah uang dibayar : &quot;" newline="True"/>
            <input variable="bayar"/>
            <while expression="bayar &lt; totalAkhir">
                <output expression="&quot;Uang pembayaran kurang! Silahkan coba lagi.&quot;" newline="True"/>
                <output expression="&quot;Jumlah uang dibayar :&quot;" newline="True"/>
                <input variable="bayar"/>
            </while>
            <assign variable="kembali" expression="bayar - totalAkhir"/>
            <output expression="&quot;Uang dibayar : &quot; &amp; bayar" newline="True"/>
            <output expression="&quot;Uang kembali : &quot; &amp; kembali" newline="True"/>
            <output expression="&quot;Terima kasih telah berbelanja!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
