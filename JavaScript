// Deklarasi variabel
let nama;
let harga;
let jumlah;
let subtotal;
let total;
let persenDiskon;
let diskon;
let totalAkhir;
let bayar;
let kembali;
let lagi;

// Inisialisasi awal
lagi = "y";
total = 0;

console.log("========== DAFTAR BELANJA ==========");

// Looping untuk memasukkan daftar barang
while (lagi == "y") {
    // prompt() digunakan untuk memunculkan pop-up input di browser
    nama = prompt("Nama barang: ");
    harga = parseFloat(prompt("Harga barang: "));
    jumlah = parseInt(prompt("Jumlah barang: "));
    
    subtotal = harga * jumlah;
    total = total + subtotal;
    
    console.log(nama + "  " + harga + " x " + jumlah + " = " + subtotal);
    
    lagi = prompt("Tambah barang lagi? (y/n): ");
}

// Menentukan diskon berdasarkan total belanja
if (total >= 100000) {
    persenDiskon = 10;
} else {
    if (total >= 50000) {
        persenDiskon = 5;
    } else {
        persenDiskon = 0;
    }

